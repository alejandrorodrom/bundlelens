{
  "name": "bundlelens",
  "version": "2.1.0",
  "description": "Framework-agnostic tool to measure and visualize objective JavaScript/TypeScript build data",
  "type": "module",
  "bin": {
    "bundlelens": "dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "exports": {
    ".": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrorodrom/bundlelens.git"
  },
  "bugs": {
    "url": "https://github.com/alejandrorodrom/bundlelens/issues"
  },
  "homepage": "https://github.com/alejandrorodrom/bundlelens#readme",
  "files": [
    "dist",
    "docs/bundlelens-logo.png",
    "bundlelens.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "bundlelens",
    "build",
    "bundle",
    "bundle-size",
    "build-metrics",
    "analysis",
    "metrics",
    "report",
    "cli",
    "gzip",
    "brotli",
    "webpack",
    "vite",
    "nextjs",
    "audit",
    "compare",
    "git"
  ],
  "author": {
    "name": "Alejandro Rodriguez Romero",
    "url": "https://www.linkedin.com/in/alejandro-rodriguez-romero/"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "cac": "^7.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.2.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
