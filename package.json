{
  "name": "bundlelens",
  "version": "0.1.0",
  "description": "Herramienta agnóstica para medir y visualizar datos objetivos de builds JavaScript/TypeScript",
  "type": "module",
  "bin": {
    "bundlelens": "dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "exports": {
    ".": "./dist/cli/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alejandrorodrom/bundlelens.git"
  },
  "bugs": {
    "url": "https://github.com/alejandrorodrom/bundlelens/issues"
  },
  "homepage": "https://github.com/alejandrorodrom/bundlelens#readme",
  "files": [
    "dist",
    "bundlelens.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "bundlelens",
    "build",
    "bundle",
    "bundle-size",
    "build-metrics",
    "analysis",
    "metrics",
    "report",
    "cli",
    "gzip",
    "brotli",
    "webpack",
    "vite",
    "nextjs",
    "audit",
    "compare",
    "git"
  ],
  "author": {
    "name": "Alejandro Rodriguez Romero",
    "url": "https://www.linkedin.com/in/alejandro-rodriguez-romero/"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "cac": "^6.7.14",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.0",
    "typescript": "^5.8.2"
  }
}
